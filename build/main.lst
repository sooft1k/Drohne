 109:Core/Src/main.c ****     }
 110:Core/Src/main.c **** 
 111:Core/Src/main.c ****     /* Regeltakt erst starten wenn die Kalibrierung durch ist */
 112:Core/Src/main.c ****     TIM2_Loop_Init();
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****     printf(">> Bereit.\r\n");
 115:Core/Src/main.c **** 
 116:Core/Src/main.c ****     const float DT = 0.001f; /* 1 ms, fest vom Timer vorgegeben */
 117:Core/Src/main.c **** 
 118:Core/Src/main.c ****     uint32_t stream_div = 0; /* 1000 Hz / 20 = 50 Hz Ausgabe */
 119:Core/Src/main.c ****     uint32_t led_div = 0;
 120:Core/Src/main.c ****     uint32_t hz_stamp = HAL_GetTick();
 121:Core/Src/main.c **** 
 122:Core/Src/main.c ****     while (1)
 123:Core/Src/main.c ****     {
 124:Core/Src/main.c ****         /* --- warten auf den naechsten Takt --- */
 125:Core/Src/main.c ****         if (!loop_flag)
 126:Core/Src/main.c ****         {
 127:Core/Src/main.c ****             /* Leerlaufzeit: hier laufen die nicht-zeitkritischen Sachen */
 128:Core/Src/main.c ****             Command_Process();
 129:Core/Src/main.c ****             continue;
 130:Core/Src/main.c ****         }
 131:Core/Src/main.c ****         loop_flag = 0;
 132:Core/Src/main.c ****         loop_count++;
 133:Core/Src/main.c **** 
 134:Core/Src/main.c ****         /* ===== REGELZYKLUS - nichts Blockierendes hineinschreiben ===== */
 135:Core/Src/main.c **** 
 136:Core/Src/main.c ****         if (mpu_ok && MPU6050_ReadAll(&hi2c1, &sensor) == HAL_OK)
 137:Core/Src/main.c ****         {
 138:Core/Src/main.c ****             MPU6050_Convert(&sensor, DT);
 139:Core/Src/main.c ****             MPU6050_UpdateAngles(&sensor, DT);
 140:Core/Src/main.c ****         }
 141:Core/Src/main.c **** 
 142:Core/Src/main.c ****         /* Funkempfang auswerten: Sollwerte, Failsafe, Arming */
 143:Core/Src/main.c ****         RC_Update(DT);
 144:Core/Src/main.c **** 
 145:Core/Src/main.c ****         float out_roll, out_pitch, out_yaw;
ARM GAS  /tmp/ccoQuZx0.s 			page 4


 146:Core/Src/main.c ****         Control_Update(&sensor, DT, &out_roll, &out_pitch, &out_yaw);
 147:Core/Src/main.c **** 
 148:Core/Src/main.c ****         Mixer_Update(setpoint.throttle, out_roll, out_pitch, out_yaw);
 149:Core/Src/main.c **** 
 150:Core/Src/main.c ****         Battery_Update(DT);
 151:Core/Src/main.c **** 
 152:Core/Src/main.c ****         /* ===== ENDE REGELZYKLUS ===== */
 153:Core/Src/main.c **** 
 154:Core/Src/main.c ****         /* Ausgabe stark gedrosselt - printf blockiert und darf den Takt nicht fressen */
 155:Core/Src/main.c ****         if (Command_StreamOn() && ++stream_div >= 20)
 156:Core/Src/main.c ****         {
 157:Core/Src/main.c ****             stream_div = 0;
 158:Core/Src/main.c ****             printf("R:%7.2f P:%7.2f | GX:%7.2f (roh %7.2f) GY:%7.2f (roh %7.2f)\r\n",
 159:Core/Src/main.c ****                    sensor.roll, sensor.pitch,
 160:Core/Src/main.c ****                    sensor.gyro_x_dps, sensor.gyro_x_raw_dps,
 161:Core/Src/main.c ****                    sensor.gyro_y_dps, sensor.gyro_y_raw_dps);
 162:Core/Src/main.c ****         }
 163:Core/Src/main.c **** 
 164:Core/Src/main.c ****         /* LED blinkt mit ~2 Hz als Lebenszeichen */
 165:Core/Src/main.c ****         if (++led_div >= 250)
 166:Core/Src/main.c ****         {
 167:Core/Src/main.c ****             led_div = 0;
 168:Core/Src/main.c ****             HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
 169:Core/Src/main.c ****         }
 170:Core/Src/main.c **** 
 171:Core/Src/main.c ****         /* Ist-Frequenz einmal pro Sekunde festhalten */
 172:Core/Src/main.c ****         uint32_t now = HAL_GetTick();
 173:Core/Src/main.c ****         if (now - hz_stamp >= 1000)
 174:Core/Src/main.c ****         {
 175:Core/Src/main.c ****             hz_stamp = now;
 176:Core/Src/main.c ****             loop_hz = loop_count;
 177:Core/Src/main.c ****             loop_count = 0;
 178:Core/Src/main.c ****         }
 179:Core/Src/main.c ****     }
 180:Core/Src/main.c **** }
