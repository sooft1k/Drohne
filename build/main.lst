 100:Core/Src/main.c **** 
 101:Core/Src/main.c ****     /* Regeltakt erst starten wenn die Kalibrierung durch ist */
 102:Core/Src/main.c ****     TIM2_Loop_Init();
 103:Core/Src/main.c **** 
 104:Core/Src/main.c ****     printf(">> Bereit.\r\n");
 105:Core/Src/main.c **** 
 106:Core/Src/main.c ****     const float DT = 0.001f; /* 1 ms, fest vom Timer vorgegeben */
 107:Core/Src/main.c **** 
 108:Core/Src/main.c ****     uint32_t stream_div = 0; /* 1000 Hz / 20 = 50 Hz Ausgabe */
 109:Core/Src/main.c ****     uint32_t led_div = 0;
 110:Core/Src/main.c ****     uint32_t hz_stamp = HAL_GetTick();
 111:Core/Src/main.c **** 
 112:Core/Src/main.c ****     while (1)
 113:Core/Src/main.c ****     {
 114:Core/Src/main.c ****         /* --- warten auf den naechsten Takt --- */
 115:Core/Src/main.c ****         if (!loop_flag)
 116:Core/Src/main.c ****         {
 117:Core/Src/main.c ****             /* Leerlaufzeit: hier laufen die nicht-zeitkritischen Sachen */
 118:Core/Src/main.c ****             Command_Process();
 119:Core/Src/main.c ****             continue;
 120:Core/Src/main.c ****         }
 121:Core/Src/main.c ****         loop_flag = 0;
 122:Core/Src/main.c ****         loop_count++;
 123:Core/Src/main.c **** 
 124:Core/Src/main.c ****         /* ===== REGELZYKLUS - nichts Blockierendes hineinschreiben ===== */
 125:Core/Src/main.c **** 
 126:Core/Src/main.c ****         if (mpu_ok && MPU6050_ReadAll(&hi2c1, &sensor) == HAL_OK)
 127:Core/Src/main.c ****         {
 128:Core/Src/main.c ****             MPU6050_Convert(&sensor);
 129:Core/Src/main.c ****             MPU6050_UpdateAngles(&sensor, DT);
 130:Core/Src/main.c ****         }
 131:Core/Src/main.c **** 
 132:Core/Src/main.c ****         float out_roll, out_pitch, out_yaw;
 133:Core/Src/main.c ****         Control_Update(&sensor, DT, &out_roll, &out_pitch, &out_yaw);
 134:Core/Src/main.c **** 
 135:Core/Src/main.c ****         Mixer_Update(setpoint.throttle, out_roll, out_pitch, out_yaw);
 136:Core/Src/main.c **** 
 137:Core/Src/main.c ****         /* ===== ENDE REGELZYKLUS ===== */
 138:Core/Src/main.c **** 
 139:Core/Src/main.c ****         /* Ausgabe stark gedrosselt - printf blockiert und darf den Takt nicht fressen */
 140:Core/Src/main.c ****         if (Command_StreamOn() && ++stream_div >= 20)
 141:Core/Src/main.c ****         {
 142:Core/Src/main.c ****             stream_div = 0;
 143:Core/Src/main.c ****             printf("Roll:%7.2f  Pitch:%7.2f  Yaw:%7.2f  | GX:%7.2f GY:%7.2f GZ:%7.2f\r\n",
 144:Core/Src/main.c ****                    sensor.roll, sensor.pitch, sensor.yaw,
 145:Core/Src/main.c ****                    sensor.gyro_x_dps, sensor.gyro_y_dps, sensor.gyro_z_dps);
ARM GAS  /tmp/ccupBWiR.s 			page 4


 146:Core/Src/main.c ****         }
 147:Core/Src/main.c **** 
 148:Core/Src/main.c ****         /* LED blinkt mit ~2 Hz als Lebenszeichen */
 149:Core/Src/main.c ****         if (++led_div >= 250)
 150:Core/Src/main.c ****         {
 151:Core/Src/main.c ****             led_div = 0;
 152:Core/Src/main.c ****             HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
 153:Core/Src/main.c ****         }
 154:Core/Src/main.c **** 
 155:Core/Src/main.c ****         /* Ist-Frequenz einmal pro Sekunde festhalten */
 156:Core/Src/main.c ****         uint32_t now = HAL_GetTick();
 157:Core/Src/main.c ****         if (now - hz_stamp >= 1000)
 158:Core/Src/main.c ****         {
 159:Core/Src/main.c ****             hz_stamp = now;
 160:Core/Src/main.c ****             loop_hz = loop_count;
 161:Core/Src/main.c ****             loop_count = 0;
 162:Core/Src/main.c ****         }
 163:Core/Src/main.c ****     }
 164:Core/Src/main.c **** }
