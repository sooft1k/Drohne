 270:Core/Src/main.c **** /* TIM2 als Regeltakt: 84 MHz / 84 = 1 MHz Tick, 1000 Ticks = 1 ms = 1000 Hz */
 271:Core/Src/main.c **** static void TIM2_Loop_Init(void)
 272:Core/Src/main.c **** {
 273:Core/Src/main.c ****     __HAL_RCC_TIM2_CLK_ENABLE();
 274:Core/Src/main.c **** 
 275:Core/Src/main.c ****     htim2.Instance = TIM2;
 276:Core/Src/main.c ****     htim2.Init.Prescaler = 84 - 1;
 277:Core/Src/main.c ****     htim2.Init.CounterMode = TIM_COUNTERMODE_UP;
 278:Core/Src/main.c ****     htim2.Init.Period = 1000 - 1;
 279:Core/Src/main.c ****     htim2.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
 280:Core/Src/main.c ****     htim2.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;
 281:Core/Src/main.c ****     if (HAL_TIM_Base_Init(&htim2) != HAL_OK)
 282:Core/Src/main.c ****         Error_Handler();
 283:Core/Src/main.c **** 
 284:Core/Src/main.c ****     /* Prioritaet hoeher als UART, damit der Takt nicht verschluckt wird */
 285:Core/Src/main.c ****     HAL_NVIC_SetPriority(TIM2_IRQn, 4, 0);
 286:Core/Src/main.c ****     HAL_NVIC_EnableIRQ(TIM2_IRQn);
 287:Core/Src/main.c **** 
 288:Core/Src/main.c ****     HAL_TIM_Base_Start_IT(&htim2);
 289:Core/Src/main.c **** }
