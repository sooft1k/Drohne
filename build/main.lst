 100:Core/Src/main.c ****     /* Regeltakt erst starten wenn die Kalibrierung durch ist */
 101:Core/Src/main.c ****     TIM2_Loop_Init();
 102:Core/Src/main.c **** 
 103:Core/Src/main.c ****     printf(">> Bereit.\r\n");
 104:Core/Src/main.c **** 
 105:Core/Src/main.c ****     const float DT = 0.001f; /* 1 ms, fest vom Timer vorgegeben */
 106:Core/Src/main.c **** 
 107:Core/Src/main.c ****     uint32_t stream_div = 0; /* 1000 Hz / 20 = 50 Hz Ausgabe */
 108:Core/Src/main.c ****     uint32_t led_div = 0;
 109:Core/Src/main.c ****     uint32_t hz_stamp = HAL_GetTick();
 110:Core/Src/main.c **** 
 111:Core/Src/main.c ****     while (1)
 112:Core/Src/main.c ****     {
 113:Core/Src/main.c ****         /* --- warten auf den naechsten Takt --- */
 114:Core/Src/main.c ****         if (!loop_flag)
 115:Core/Src/main.c ****         {
 116:Core/Src/main.c ****             /* Leerlaufzeit: hier laufen die nicht-zeitkritischen Sachen */
 117:Core/Src/main.c ****             Command_Process();
 118:Core/Src/main.c ****             continue;
 119:Core/Src/main.c ****         }
 120:Core/Src/main.c ****         loop_flag = 0;
 121:Core/Src/main.c ****         loop_count++;
 122:Core/Src/main.c **** 
 123:Core/Src/main.c ****         /* ===== REGELZYKLUS - nichts Blockierendes hineinschreiben ===== */
 124:Core/Src/main.c **** 
 125:Core/Src/main.c ****         if (mpu_ok && MPU6050_ReadAll(&hi2c1, &sensor) == HAL_OK)
 126:Core/Src/main.c ****         {
 127:Core/Src/main.c ****             MPU6050_Convert(&sensor);
 128:Core/Src/main.c ****             MPU6050_UpdateAngles(&sensor, DT);
 129:Core/Src/main.c ****         }
 130:Core/Src/main.c **** 
 131:Core/Src/main.c ****         float out_roll, out_pitch, out_yaw;
 132:Core/Src/main.c ****         Control_Update(&sensor, DT, &out_roll, &out_pitch, &out_yaw);
 133:Core/Src/main.c **** 
 134:Core/Src/main.c ****         Mixer_Update(setpoint.throttle, out_roll, out_pitch, out_yaw);
 135:Core/Src/main.c ****         /* Noch ungenutzt - in Schritt 3 holt der Mixer die Werte ab */
 136:Core/Src/main.c ****         (void)out_roll;
 137:Core/Src/main.c ****         (void)out_pitch;
 138:Core/Src/main.c ****         (void)out_yaw;
 139:Core/Src/main.c **** 
 140:Core/Src/main.c ****         /* ===== ENDE REGELZYKLUS ===== */
 141:Core/Src/main.c **** 
 142:Core/Src/main.c ****         /* Ausgabe stark gedrosselt - printf blockiert und darf den Takt nicht fressen */
 143:Core/Src/main.c ****         if (Command_StreamOn() && ++stream_div >= 20)
 144:Core/Src/main.c ****         {
 145:Core/Src/main.c ****             stream_div = 0;
ARM GAS  /tmp/cceZRkSc.s 			page 4


 146:Core/Src/main.c ****             printf("Roll:%7.2f  Pitch:%7.2f  Yaw:%7.2f  | GX:%7.2f GY:%7.2f GZ:%7.2f\r\n",
 147:Core/Src/main.c ****                    sensor.roll, sensor.pitch, sensor.yaw,
 148:Core/Src/main.c ****                    sensor.gyro_x_dps, sensor.gyro_y_dps, sensor.gyro_z_dps);
 149:Core/Src/main.c ****         }
 150:Core/Src/main.c **** 
 151:Core/Src/main.c ****         /* LED blinkt mit ~2 Hz als Lebenszeichen */
 152:Core/Src/main.c ****         if (++led_div >= 250)
 153:Core/Src/main.c ****         {
 154:Core/Src/main.c ****             led_div = 0;
 155:Core/Src/main.c ****             HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
 156:Core/Src/main.c ****         }
 157:Core/Src/main.c **** 
 158:Core/Src/main.c ****         /* Ist-Frequenz einmal pro Sekunde festhalten */
 159:Core/Src/main.c ****         uint32_t now = HAL_GetTick();
 160:Core/Src/main.c ****         if (now - hz_stamp >= 1000)
 161:Core/Src/main.c ****         {
 162:Core/Src/main.c ****             hz_stamp = now;
 163:Core/Src/main.c ****             loop_hz = loop_count;
 164:Core/Src/main.c ****             loop_count = 0;
 165:Core/Src/main.c ****         }
 166:Core/Src/main.c ****     }
 167:Core/Src/main.c **** }
