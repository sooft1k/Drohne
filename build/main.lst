 102:Core/Src/main.c **** 
 103:Core/Src/main.c ****     /* Regeltakt erst starten wenn die Kalibrierung durch ist */
 104:Core/Src/main.c ****     TIM2_Loop_Init();
 105:Core/Src/main.c **** 
 106:Core/Src/main.c ****     printf(">> Bereit.\r\n");
 107:Core/Src/main.c **** 
 108:Core/Src/main.c ****     const float DT = 0.001f; /* 1 ms, fest vom Timer vorgegeben */
 109:Core/Src/main.c **** 
 110:Core/Src/main.c ****     uint32_t stream_div = 0; /* 1000 Hz / 20 = 50 Hz Ausgabe */
 111:Core/Src/main.c ****     uint32_t led_div = 0;
 112:Core/Src/main.c ****     uint32_t hz_stamp = HAL_GetTick();
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****     while (1)
 115:Core/Src/main.c ****     {
 116:Core/Src/main.c ****         /* --- warten auf den naechsten Takt --- */
 117:Core/Src/main.c ****         if (!loop_flag)
 118:Core/Src/main.c ****         {
 119:Core/Src/main.c ****             /* Leerlaufzeit: hier laufen die nicht-zeitkritischen Sachen */
 120:Core/Src/main.c ****             Command_Process();
 121:Core/Src/main.c ****             continue;
 122:Core/Src/main.c ****         }
 123:Core/Src/main.c ****         loop_flag = 0;
 124:Core/Src/main.c ****         loop_count++;
 125:Core/Src/main.c **** 
 126:Core/Src/main.c ****         /* ===== REGELZYKLUS - nichts Blockierendes hineinschreiben ===== */
 127:Core/Src/main.c **** 
 128:Core/Src/main.c ****         if (mpu_ok && MPU6050_ReadAll(&hi2c1, &sensor) == HAL_OK)
 129:Core/Src/main.c ****         {
 130:Core/Src/main.c ****             MPU6050_Convert(&sensor, DT);
 131:Core/Src/main.c ****             MPU6050_UpdateAngles(&sensor, DT);
 132:Core/Src/main.c ****         }
 133:Core/Src/main.c **** 
 134:Core/Src/main.c ****         float out_roll, out_pitch, out_yaw;
 135:Core/Src/main.c ****         Control_Update(&sensor, DT, &out_roll, &out_pitch, &out_yaw);
 136:Core/Src/main.c **** 
 137:Core/Src/main.c ****         Mixer_Update(setpoint.throttle, out_roll, out_pitch, out_yaw);
 138:Core/Src/main.c **** 
 139:Core/Src/main.c ****         Battery_Update(DT);
 140:Core/Src/main.c **** 
 141:Core/Src/main.c ****         /* ===== ENDE REGELZYKLUS ===== */
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****         /* Ausgabe stark gedrosselt - printf blockiert und darf den Takt nicht fressen */
 144:Core/Src/main.c ****         if (Command_StreamOn() && ++stream_div >= 20)
 145:Core/Src/main.c ****         {
ARM GAS  /tmp/ccOcGuX2.s 			page 4


 146:Core/Src/main.c ****             stream_div = 0;
 147:Core/Src/main.c ****             printf("R:%7.2f P:%7.2f | GX:%7.2f (roh %7.2f) GY:%7.2f (roh %7.2f)\r\n",
 148:Core/Src/main.c ****                    sensor.roll, sensor.pitch,
 149:Core/Src/main.c ****                    sensor.gyro_x_dps, sensor.gyro_x_raw_dps,
 150:Core/Src/main.c ****                    sensor.gyro_y_dps, sensor.gyro_y_raw_dps);
 151:Core/Src/main.c ****         }
 152:Core/Src/main.c **** 
 153:Core/Src/main.c ****         /* LED blinkt mit ~2 Hz als Lebenszeichen */
 154:Core/Src/main.c ****         if (++led_div >= 250)
 155:Core/Src/main.c ****         {
 156:Core/Src/main.c ****             led_div = 0;
 157:Core/Src/main.c ****             HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
 158:Core/Src/main.c ****         }
 159:Core/Src/main.c **** 
 160:Core/Src/main.c ****         /* Ist-Frequenz einmal pro Sekunde festhalten */
 161:Core/Src/main.c ****         uint32_t now = HAL_GetTick();
 162:Core/Src/main.c ****         if (now - hz_stamp >= 1000)
 163:Core/Src/main.c ****         {
 164:Core/Src/main.c ****             hz_stamp = now;
 165:Core/Src/main.c ****             loop_hz = loop_count;
 166:Core/Src/main.c ****             loop_count = 0;
 167:Core/Src/main.c ****         }
 168:Core/Src/main.c ****     }
 169:Core/Src/main.c **** }
