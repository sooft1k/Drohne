   1:Sensors/mpu6050.c **** #include "mpu6050.h"
   2:Sensors/mpu6050.c **** #include <math.h>
   3:Sensors/mpu6050.c **** 
   4:Sensors/mpu6050.c **** #define ACCEL_SCALE 16384.0f /* LSB pro g   (+-2g)      */
   5:Sensors/mpu6050.c **** #define GYRO_SCALE 131.0f    /* LSB pro Grad/s (+-250)  */
   6:Sensors/mpu6050.c **** 
   7:Sensors/mpu6050.c **** /* Einstellbare Filterparameter */
   8:Sensors/mpu6050.c **** static float gyro_lpf_hz = GYRO_LPF_DEFAULT_HZ;
   9:Sensors/mpu6050.c **** static float accel_lpf_hz = ACCEL_LPF_DEFAULT_HZ;
  10:Sensors/mpu6050.c **** static float comp_tau_s = COMP_TAU_DEFAULT_S;
  11:Sensors/mpu6050.c **** 
  12:Sensors/mpu6050.c **** /* Zustand der Tiefpaesse */
  13:Sensors/mpu6050.c **** static float gx_f = 0, gy_f = 0, gz_f = 0;
  14:Sensors/mpu6050.c **** static float ax_f = 0, ay_f = 0, az_f = 1.0f;
  15:Sensors/mpu6050.c **** static uint8_t filt_primed = 0;
  16:Sensors/mpu6050.c **** 
  17:Sensors/mpu6050.c **** /* Tiefpass erster Ordnung (PT1).
  18:Sensors/mpu6050.c ****  * Grenzfrequenz f, Zeitschritt dt:
  19:Sensors/mpu6050.c ****  *   a = dt / (1/(2*pi*f) + dt)
  20:Sensors/mpu6050.c ****  * a nahe 1 = kaum Filterung, a klein = starke Filterung. */
  21:Sensors/mpu6050.c **** static inline float pt1(float prev, float in, float hz, float dt)
  22:Sensors/mpu6050.c **** {
  23:Sensors/mpu6050.c ****     if (hz <= 0.0f)
  24:Sensors/mpu6050.c ****         return in; /* Filter aus */
  25:Sensors/mpu6050.c ****     const float rc = 1.0f / (2.0f * 3.14159265f * hz);
  26:Sensors/mpu6050.c ****     const float a = dt / (rc + dt);
  27:Sensors/mpu6050.c ****     return prev + a * (in - prev);
  28:Sensors/mpu6050.c **** }
  29:Sensors/mpu6050.c **** 
