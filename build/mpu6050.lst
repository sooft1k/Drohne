  74:Sensors/mpu6050.c **** 
  75:Sensors/mpu6050.c ****     /* Interner Hardware-Tiefpass: DLPF_CFG = 1 -> Gyro 188 Hz, Accel 184 Hz.
  76:Sensors/mpu6050.c ****      * Erste Stufe gegen Motorvibrationen. Gleichzeitig sinkt die interne
  77:Sensors/mpu6050.c ****      * Gyro-Rate von 8 kHz auf 1 kHz - passend zur Regelschleife. */
  78:Sensors/mpu6050.c ****     data = 0x01;
  79:Sensors/mpu6050.c ****     status = HAL_I2C_Mem_Write(hi2c, MPU6050_ADDR, MPU6050_CONFIG,
