  66:Sensors/mpu6050.c ****     /* Aus Sleep-Mode wecken, Takt vom Gyro statt vom internen Oszillator
  67:Sensors/mpu6050.c ****      * (stabiler, empfiehlt InvenSense selbst) */
  68:Sensors/mpu6050.c ****     uint8_t data = 0x01;
