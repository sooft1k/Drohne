  83:Sensors/mpu6050.c **** 
  84:Sensors/mpu6050.c ****     /* Sample Rate = 1 kHz / (1+0) = 1000 Hz - ein frischer Wert pro Regelzyklus */
  85:Sensors/mpu6050.c ****     data = 0x00;
  86:Sensors/mpu6050.c ****     status = HAL_I2C_Mem_Write(hi2c, MPU6050_ADDR, MPU6050_SMPLRT_DIV,
  87:Sensors/mpu6050.c ****                                I2C_MEMADD_SIZE_8BIT, &data, 1, 100);
