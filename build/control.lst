  19:Sensors/control.c **** #define RATE_ILIM 50.0f
  20:Sensors/control.c **** #define RATE_OUTLIM 400.0f
  21:Sensors/control.c **** #define RATE_DLPF 0.85f
  22:Sensors/control.c **** 
  23:Sensors/control.c **** /* ---- Startwerte aeusserer Kreis (Winkel) ----
  24:Sensors/control.c ****  * Braucht praktisch nur P. I fuehrt zu traegem Nachlaufen,
  25:Sensors/control.c ****  * D ist ueberfluessig weil der innere Kreis schon daempft. */
