  43:Sensors/motor.c ****     /* Timer-Basis: Werte kommen aus motor.h, je nach Protokoll.
  44:Sensors/motor.c ****      * Oneshot125: 42 MHz Tick, 1 kHz Wiederholrate, Pulse 125..250 us
  45:Sensors/motor.c ****      * PWM:         1 MHz Tick, 50 Hz Wiederholrate, Pulse 1000..2000 us */
  46:Sensors/motor.c ****     motor_tim->Instance = TIM3;
  47:Sensors/motor.c ****     motor_tim->Init.Prescaler = MOTOR_TIM_PRESCALER;
  48:Sensors/motor.c ****     motor_tim->Init.CounterMode = TIM_COUNTERMODE_UP;
  49:Sensors/motor.c ****     motor_tim->Init.Period = MOTOR_TIM_PERIOD;
  50:Sensors/motor.c ****     motor_tim->Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
  51:Sensors/motor.c ****     motor_tim->Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;
  52:Sensors/motor.c ****     if (HAL_TIM_PWM_Init(motor_tim) != HAL_OK)
  53:Sensors/motor.c ****         Error_Handler();
  54:Sensors/motor.c **** 
  55:Sensors/motor.c ****     /* Alle vier Kanaele gleich konfigurieren */
  56:Sensors/motor.c ****     TIM_OC_InitTypeDef oc = {0};
  57:Sensors/motor.c ****     oc.OCMode = TIM_OCMODE_PWM1;
  58:Sensors/motor.c ****     oc.Pulse = (uint32_t)MOTOR_US_IDLE * MOTOR_TICKS_PER_US; /* SICHER: Stopp */
  59:Sensors/motor.c ****     oc.OCPolarity = TIM_OCPOLARITY_HIGH;
  60:Sensors/motor.c ****     oc.OCFastMode = TIM_OCFAST_DISABLE;
  61:Sensors/motor.c **** 
  62:Sensors/motor.c ****     for (uint8_t i = 0; i < MOTOR_COUNT; i++)
  63:Sensors/motor.c ****     {
  64:Sensors/motor.c ****         if (HAL_TIM_PWM_ConfigChannel(motor_tim, &oc, motor_ch[i]) != HAL_OK)
  65:Sensors/motor.c ****             Error_Handler();
  66:Sensors/motor.c ****         HAL_TIM_PWM_Start(motor_tim, motor_ch[i]);
  67:Sensors/motor.c ****     }
  68:Sensors/motor.c **** 
  69:Sensors/motor.c ****     armed = 0; /* Start immer disarmed */
  70:Sensors/motor.c ****     Motor_SetAllUs(MOTOR_US_IDLE);
  71:Sensors/motor.c **** }
