 101:Sensors/battery.c **** 
 102:Sensors/battery.c ****     /* Zellenzahl einmalig bestimmen, sobald sich der Wert beruhigt hat.
 103:Sensors/battery.c ****      * Eine Zelle liegt zwischen 3,0 und 4,25 V - daraus laesst sich die
 104:Sensors/battery.c ****      * Zahl eindeutig ausrechnen. Danach bleibt sie fest, sonst wuerde die
 105:Sensors/battery.c ****      * Erkennung bei leerem Akku auf eine Zelle weniger springen. */
 106:Sensors/battery.c ****     if (cells == 0)
 107:Sensors/battery.c ****     {
 108:Sensors/battery.c ****         if (settle < 100) /* etwa eine Sekunde warten */
 109:Sensors/battery.c ****         {
 110:Sensors/battery.c ****             settle++;
 111:Sensors/battery.c ****             return;
 112:Sensors/battery.c ****         }
 113:Sensors/battery.c ****         for (uint8_t c = 2; c <= 6; c++)
 114:Sensors/battery.c ****         {
 115:Sensors/battery.c ****             const float cv = volt / c;
 116:Sensors/battery.c ****             if (cv >= 3.30f && cv <= 4.30f)
 117:Sensors/battery.c ****             {
 118:Sensors/battery.c ****                 cells = c;
 119:Sensors/battery.c ****                 break;
 120:Sensors/battery.c ****             }
 121:Sensors/battery.c ****         }
 122:Sensors/battery.c ****         if (cells == 0)
 123:Sensors/battery.c ****             return; /* nichts Sinnvolles erkannt */
 124:Sensors/battery.c ****     }
 125:Sensors/battery.c **** 
 126:Sensors/battery.c ****     const float cv = volt / cells;
 127:Sensors/battery.c ****     if (cv < BAT_CRIT_V)
 128:Sensors/battery.c ****         state = BAT_CRITICAL;
 129:Sensors/battery.c ****     else if (cv < BAT_WARN_V)
 130:Sensors/battery.c ****         state = BAT_WARN;
 131:Sensors/battery.c ****     else
